<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required under the hardened runtime so the app can capture the microphone
         (and the meeting/system audio via Core Audio taps). Without this, a
         notarized/hardened build is denied audio access and never even prompts. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
